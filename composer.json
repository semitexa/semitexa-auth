{
    "name": "semitexa/auth",
    "description": "Semitexa Auth - user authentication with credential flows, sessions, and access tokens",
    "type": "semitexa-module",
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "semitexa/core": ">=2026.10.29.1052 || dev-master"
    },
    "autoload": {
        "psr-4": {
            "Semitexa\\Auth\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Semitexa\\Auth\\Tests\\": "tests/"
        }
    },
    "extra": {
        "semitexa-module": {
            "extends": null
        },
        "semitexa": {
            "floors": {
                "semitexa/core": "2026.10.29.1052"
            }
        }
    },
    "keywords": [
        "semitexa",
        "auth",
        "authentication",
        "sessions",
        "tokens"
    ]
}
